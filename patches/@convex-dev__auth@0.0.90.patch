+// Mwalimu AI patch: four quick retries spread over ~10s (the server's refresh-token reuse window, so a retry is
+// safe even if an earlier attempt reached the server), then, if the device is offline, wait for the connection
+// instead of giving up: offline requests never reached the server, so the same refresh token is still valid.
+const RETRY_BACKOFF = [500, 1500, 3000, 4500]; // In ms
+const OFFLINE_WAIT_MS = 120000;
+const OFFLINE_ROUNDS = 3;
+function isOffline() {
+    return typeof navigator !== "undefined" && navigator.onLine === false;
+}
+function waitForOnline(ms) {
+    return new Promise((resolve) => {
+        const done = () => {
+            clearTimeout(timer);
+            window.removeEventListener?.("online", done);
+            resolve();
+        };
+        const timer = setTimeout(done, ms);
+        window.addEventListener?.("online", done);
+    });
+}
 const RETRY_JITTER = 100; // In ms
