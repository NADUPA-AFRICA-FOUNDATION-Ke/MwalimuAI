# ─────────────────────────────────────────────────────────────────
# Mwalimu AI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Convex — set after `npx convex dev` creates a deployment ──────────────
NEXT_PUBLIC_CONVEX_URL=<your-convex-deployment-url>
# Used by `npx convex deploy` when the CLI is not already authenticated.
CONVEX_DEPLOY_KEY=<your-convex-deploy-key>
# ── Convex Auth ────────────────────────────────────────────────────────────
# Generate these once for the Convex deployment; never commit them.
JWT_PRIVATE_KEY=<generated-convex-auth-private-key>
JWKS=<generated-convex-auth-jwks-json>
SITE_URL=https://your-production-domain.com

# ── Convex Auth OAuth providers (set with `npx convex env set` in production) ─
# Callback URLs are documented in ENV_SETUP.md and must be registered with each provider.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# Optional: restrict sign-in to one Entra tenant. Use the full issuer URL.
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# Used for Convex Auth verification and password-reset emails.
RESEND_API_KEY=<your-resend-api-key>
AUTH_EMAIL_FROM=Mwalimu AI <auth@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# Migration-only secrets. Keep these out of git and unset after cutover.
MIGRATION_SECRET=<long-random-migration-secret>
CONVEX_URL=<your-convex-deployment-url>

# ── AI Backend ────────────────────────────────────────────────────
# Groq (free tier, fast) — https://console.groq.com/keys
GROQ_API_KEY=

# ── Stripe (optional) — https://dashboard.stripe.com/apikeys ─────
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_

# ── App URL (used for Stripe redirect + auth callbacks) ───────────
NEXT_PUBLIC_APP_URL=https://your-deployment.vercel.app
